[hummingbird]
name=Hummingbird - $basearch
baseurl=https://packages.redhat.com/api/pulp-content/public-hummingbird/$arch/
# gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-hummingbird-release-SHA256
gpgcheck=0
enabled=1
sslverify=1
priority=10

[hummingbird-source]
name=Hummingbird - Source
baseurl=https://packages.redhat.com/api/pulp-content/public-hummingbird/source/
# gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-hummingbird-release-SHA256
gpgcheck=0
enabled=0
sslverify=1
