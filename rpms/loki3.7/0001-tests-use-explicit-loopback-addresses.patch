From: Hummingbird RPM maintainers
Subject: [PATCH] tests: use explicit loopback addresses

Isolated RPM builders do not guarantee a usable address on conventional
network interfaces. These unit tests only need a local address, so avoid
interface-based address discovery.

diff --git a/pkg/limits/frontend/frontend_test.go b/pkg/limits/frontend/frontend_test.go
--- a/pkg/limits/frontend/frontend_test.go
+++ b/pkg/limits/frontend/frontend_test.go
@@ -160,6 +160,7 @@ func TestFrontend_ExceedsLimits(t *testing.T) {
 			readRing, _ := newMockRingWithClientPool(t, "test", nil, nil)
 			f, err := New(Config{
 				LifecyclerConfig: ring.LifecyclerConfig{
+					Addr: "127.0.0.1",
 					RingConfig: ring.Config{
 						KVStore: kv.Config{
 							Store: "inmemory",
