diff --git a/pkg/loki/modules_test.go b/pkg/loki/modules_test.go
--- a/pkg/loki/modules_test.go
+++ b/pkg/loki/modules_test.go
@@ -376,6 +376,7 @@ func TestUIServiceInitialization(t *testing.T) {
 	t.Run("UI is initialized when enabled", func(t *testing.T) {
 		cfg := minimalWorkingConfig(t, dir, All, func(cfg *Config) {
 			cfg.UI.Enabled = true
+			cfg.UI.Ring.InstanceAddr = "127.0.0.1"
 		})
		c, err := New(cfg)
		require.NoError(t, err)
