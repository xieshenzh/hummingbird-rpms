From 9f08d9a4b3b0d93b9ea4fe8857e6f6d2428c1f11 Mon Sep 17 00:00:00 2001
From: Prarit Bhargava <prarit@redhat.com>
Date: Thu, 9 Jul 2026 19:31:00 -0400
Subject: [PATCH] deps: make c-ares host callback signature compatible

Replaces the previous version-gated approach (which assumed c-ares
>= 1.34.7 permanently changed ares_host_callback to take a const
hostent*). That assumption is incorrect: c-ares's own upstream header
explicitly documents that the const-hostent change was tried (PR
#1060) and reverted, and states "Do not re-add const" - the real,
stable ares_host_callback typedef takes a non-const struct hostent*
regardless of c-ares version.

Some buildroots may still provide a c-ares header where
ares_host_callback takes `const struct hostent*`, while others use
`struct hostent*`. Provide both callback overloads and route both
through a shared helper to keep compatibility regardless of which
ABI variant is actually linked, instead of guessing based on version.

Ported from the equivalent nodejs26 fix
(0002-cares-host-callback-compat.patch).
---
 src/cares_wrap.h | 21 ++++++++++++++++++---
 1 file changed, 18 insertions(+), 3 deletions(-)

diff --git a/src/cares_wrap.h b/src/cares_wrap.h
--- a/src/cares_wrap.h
+++ b/src/cares_wrap.h
@@ -348,11 +348,10 @@ class QueryWrap final : public AsyncWrap {
     wrap->QueueResponseCallback(status);
   }
 
-  static void Callback(
+  static void HandleHostCallback(
       void* arg,
       int status,
-      int timeouts,
-      struct hostent* host) {
+      const struct hostent* host) {
     QueryWrap<Traits>* wrap = FromCallbackPointer(arg);
     if (wrap == nullptr) return;
 
@@ -371,6 +370,22 @@ class QueryWrap final : public AsyncWrap {
     wrap->QueueResponseCallback(status);
   }
 
+  static void Callback(
+      void* arg,
+      int status,
+      int timeouts,
+      struct hostent* host) {
+    HandleHostCallback(arg, status, host);
+  }
+
+  static void Callback(
+      void* arg,
+      int status,
+      int timeouts,
+      const struct hostent* host) {
+    HandleHostCallback(arg, status, host);
+  }
+
   void QueuePermissionModelResponseCallback(const char* resource) {
     BaseObjectPtr<QueryWrap<Traits>> strong_ref{this};
     const std::string res{resource};
-- 
2.54.0
</content>
