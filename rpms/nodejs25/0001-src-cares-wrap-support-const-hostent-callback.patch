From 9fb5740d372dfd2942d5f6ce0c930eff7fdb6b9a Mon Sep 17 00:00:00 2001
From: Prarit Bhargava <prarit@redhat.com>
Date: Thu, 9 Jul 2026 18:33:00 -0400
Subject: [PATCH] src: support const hostent callback in c-ares 1.34.7

c-ares 1.34.7 updates ares_host_callback to use a const hostent
pointer. nodejs25 still declares QueryWrap's host callback with a
mutable hostent pointer, which no longer matches the callback type and
fails the build on aarch64 and x86_64.

Use a version-gated alias for the callback parameter type so the same
code compiles with both pre-1.34.7 and 1.34.7+ c-ares headers.
---
 src/cares_wrap.h | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/cares_wrap.h b/src/cares_wrap.h
--- a/src/cares_wrap.h
+++ b/src/cares_wrap.h
@@ -37,6 +37,12 @@ class ChannelWrap;
 inline void safe_free_hostent(struct hostent* host);
 
 using HostEntPointer = DeleteFnPtr<hostent, ares_free_hostent>;
+// c-ares 1.34.7 changed ares_host_callback to take const hostent*.
+#if ARES_VERSION >= 0x012207
+using AresHostEnt = const struct hostent;
+#else
+using AresHostEnt = struct hostent;
+#endif
 using SafeHostEntPointer = DeleteFnPtr<hostent, safe_free_hostent>;
 
 inline const char* ToErrorCodeString(int status) {
@@ -351,7 +357,7 @@ class QueryWrap final : public AsyncWrap {
   static void Callback(
       void* arg,
       int status,
       int timeouts,
-      struct hostent* host) {
+      AresHostEnt* host) {
     QueryWrap<Traits>* wrap = FromCallbackPointer(arg);
     if (wrap == nullptr) return;
 
-- 
