summary: centos stream tests for galera

environment:
  BUILD_PACKAGE: mariadb11.8-server

prepare:
  how: shell
  script: |
    dnf install -y mariadb11.8-server-galera wireshark-cli

discover:
  how: fmf
  url: https://gitlab.com/redhat/centos-stream/tests/mariadb/
  ref: main
  filter: tag:galera&tag:single-host

execute:
  how: tmt
