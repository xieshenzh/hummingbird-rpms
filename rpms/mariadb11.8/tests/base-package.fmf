summary: centos stream tests for mariadb11.8

environment:
  BUILD_PACKAGE: mariadb11.8-server

prepare:
  how: shell
  script: |
    dnf install -y $BUILD_PACKAGE

discover:
  how: fmf
  url: https://gitlab.com/redhat/centos-stream/tests/mariadb/
  ref: main
  filter: tag:base-package

execute:
  how: tmt
