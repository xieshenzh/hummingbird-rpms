diff --git a/src/crypto/internal/fips140deps/godebug/godebug.go b/src/crypto/internal/fips140deps/godebug/godebug.go
index de50d61..22bda7a 100644
--- a/src/crypto/internal/fips140deps/godebug/godebug.go
+++ b/src/crypto/internal/fips140deps/godebug/godebug.go
@@ -5,6 +5,7 @@
 package godebug
 
 import (
+	"crypto/internal/fips140deps/hostfips"
 	"internal/godebug"
 )
 
@@ -19,5 +20,14 @@ func (s *Setting) Value() string {
 }
 
 func Value(name string) string {
-	return godebug.New(name).Value()
+	v := godebug.New(name).Value()
+	// When fips140=auto is set, check host FIPS mode and resolve to
+	// "on" if enabled, or "" (off) if not.
+	if name == "#fips140" && v == "auto" {
+		if hostfips.Enabled() {
+			return "on"
+		}
+		return ""
+	}
+	return v
 }
diff --git a/src/crypto/internal/fips140deps/hostfips/hostfips.go b/src/crypto/internal/fips140deps/hostfips/hostfips.go
new file mode 100644
index 0000000..da08e30
--- /dev/null
+++ b/src/crypto/internal/fips140deps/hostfips/hostfips.go
@@ -0,0 +1,42 @@
+// Copyright 2017 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package hostfips
+
+import (
+	"os"
+	"sync"
+)
+
+var (
+	enabled     bool
+	enabledOnce sync.Once
+)
+
+// Enabled returns true if the host system has FIPS mode enabled,
+// or if GOLANG_NATIVE_HOSTFIPS_OVERRIDE=1 is set for testing.
+// It checks /proc/sys/crypto/fips_enabled on Linux.
+// The result is cached after the first call.
+func Enabled() bool {
+	enabledOnce.Do(func() {
+		if os.Getenv("GOLANG_NATIVE_HOSTFIPS_OVERRIDE") == "1" {
+			enabled = true
+			return
+		}
+		enabled = checkHostFIPS()
+	})
+	return enabled
+}
+
+func checkHostFIPS() bool {
+	data, err := os.ReadFile("/proc/sys/crypto/fips_enabled")
+	if err != nil {
+		if os.IsNotExist(err) {
+			return false
+		}
+		os.Stderr.WriteString("error reading /proc/sys/crypto/fips_enabled: " + err.Error() + "\n")
+		os.Exit(1)
+	}
+	return len(data) > 0 && data[0] == '1'
+}
