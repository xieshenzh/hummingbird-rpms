From: Hummingbird <hummingbird@redhat.com>
Subject: [PATCH] Bump nanoid to 5.1.16 for CVE-2026-67213 CVE-2026-67214

As of grafana 13.1.3, upstream's own nanoid@npm:^3.3.16 resolution
already matches this CVE fix's 3.x target (3.3.16) -- only the 5.x
line (upstream still at 5.1.6) needs bumping now.

diff --git a/package.json b/package.json
index 40da4a56..9353def8 100644
--- a/package.json
+++ b/package.json
@@ -416,6 +416,7 @@
     "whatwg-fetch": "3.6.20"
   },
   "resolutions": {
+    "nanoid@npm:^5.0.9": "5.1.16",
     "underscore": "1.13.8",
     "@types/slate": "0.47.11",
     "semver@npm:~7.3.5": "^7.3.5",
diff --git a/yarn.lock b/yarn.lock
index dbdb5799..a483238a 100644
--- a/yarn.lock
+++ b/yarn.lock
@@ -24384,6 +24384,15 @@ __metadata:
   languageName: node
   linkType: hard
 
+"nanoid@npm:5.1.16":
+  version: 5.1.16
+  resolution: "nanoid@npm:5.1.16"
+  bin:
+    nanoid: bin/nanoid.js
+  checksum: 10/b1e702e2b7072e74ac2ae880907d0a291853a36617ec5c3d27d81ab04965ebc0d4d0f707cf9220928cf93d5370b1f561c930efee853dc9c1a3facaefdf1a42ee
+  languageName: node
+  linkType: hard
+
 "nanoid@npm:^3.3.16":
   version: 3.3.16
   resolution: "nanoid@npm:3.3.16"
@@ -24393,15 +24402,6 @@ __metadata:
   languageName: node
   linkType: hard
 
-"nanoid@npm:^5.0.9":
