 		if err != nil {
 			return 0, err
 		}
 		result |= int64(b&0x7f) << shift
 		if (b & 0x80) != 0x80 {
-			break
+			return result, nil
 		}
 		shift += 7
 	}
-	return result, nil
+	return 0, NewTProtocolExceptionWithType(INVALID_DATA, errors.New("variable-length int over 10 bytes"))
 }
 
