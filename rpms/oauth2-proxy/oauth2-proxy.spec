%bcond check 1

%global goipath github.com/oauth2-proxy/oauth2-proxy/v7

Name:           oauth2-proxy
Version:        7.15.3
Release:        0.1%{?dist}
Summary:        Reverse proxy providing authentication with OAuth2/OIDC providers

# Generated by go-vendor-tools
