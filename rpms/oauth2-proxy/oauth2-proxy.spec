%install
%go_vendor_license_install -c %{S:2}
install -Dp -m 0755 ./oauth2-proxy -t %{buildroot}%{_bindir}

%check
%go_vendor_license_check -c %{S:2}
[[ "$(./oauth2-proxy --version 2>&1)" == *"%{version}"* ]] || exit 1
%if %{with check}
%gotest ./...
%endif

%files -f %{go_vendor_license_filelist}
%doc README.md
%{_bindir}/oauth2-proxy

%changelog
