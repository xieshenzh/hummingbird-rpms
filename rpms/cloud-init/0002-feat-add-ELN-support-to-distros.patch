 systemd/cloud-init-generator.tmpl       |  2 +-
 systemd/cloud-init-local.service.tmpl   |  2 +-
 systemd/cloud-init-main.service.tmpl    |  2 +-
 systemd/cloud-init-network.service.tmpl |  2 +-
 14 files changed, 32 insertions(+), 7 deletions(-)
 create mode 100644 cloudinit/distros/eln.py

