From ba2b04b114c5dd945107ccc613cedfcca3af73bb Mon Sep 17 00:00:00 2001
From: waugustus <wangdw.augustus@qq.com>
Date: Thu, 23 Apr 2026 17:05:53 +0800
Subject: [PATCH] pixarlog: fix heap-buffer-overflow in 8BITABGR decode with
 stride 3

Consolidated backport of upstream commits ba2b04b114c5, f9bda11bf2fc,
and 90601d9a2338, adapted for libtiff 4.7.1.

The horizontalAccumulate8abgr function writes 4 output bytes per 3
decoded samples (synthetic alpha byte) but PixarLogDecode advances the
output cursor by only 3 bytes when stride == 3, causing a linear
heap-based buffer overflow.

Fix the output pointer advancement and add buffer size validation for
the ABGR stride-3 expansion path.

Upstream: https://github.com/libsdl-org/libtiff/commit/ba2b04b114c5
Upstream: https://github.com/libsdl-org/libtiff/commit/f9bda11bf2fc
Upstream: https://github.com/libsdl-org/libtiff/commit/90601d9a2338
---
 libtiff/tif_pixarlog.c | 39 ++++++++++++++++++++++++++++++++++++++-
 1 file changed, 38 insertions(+), 1 deletion(-)

--- a/libtiff/tif_pixarlog.c	
+++ b/libtiff/tif_pixarlog.c	
@@ -865,6 +865,42 @@
 
     llen = sp->stride * td->td_imagewidth;
 
+    /* Fix: ABGR with stride=3 expands 3 samples to 4 output bytes per pixel */
+    if (sp->user_datafmt == PIXARLOGDATAFMT_8BITABGR && sp->stride == 3)
+    {
+        tmsize_t required = (tmsize_t)td->td_imagewidth * 4;
+        tmsize_t max_rows;
+        tmsize_t max_nsamples;
+
+        if (occ < required)
+        {
+            TIFFErrorExtR(tif, module,
+                          "Output buffer too small for PixarLog ABGR data");
+            memset(op, 0, (size_t)occ);
+            return (0);
+        }
+
+        if (occ % required)
+        {
+            TIFFErrorExtR(
+                tif, module,
+                "Fractional scanline not supported for PixarLog ABGR data");
+            memset(op, 0, (size_t)occ);
+            return (0);
+        }
+
+        max_rows = occ / required;
+        max_nsamples = max_rows * llen;
+
+        if (nsamples > max_nsamples)
+        {
+            TIFFErrorExtR(tif, module,
+                          "Output buffer too small for PixarLog ABGR data");
+            memset(op, 0, (size_t)occ);
+            return (0);
+        }
+    }
+
     (void)s;
     assert(sp != NULL);
 
@@ -978,7 +1014,10 @@
             case PIXARLOGDATAFMT_8BITABGR:
                 horizontalAccumulate8abgr(up, llen, sp->stride,
                                           (unsigned char *)op, sp->ToLinear8);
-                op += llen * sizeof(unsigned char);
+                if (sp->stride == 3)
+                    op += (tmsize_t)td->td_imagewidth * 4;
+                else
+                    op += llen * sizeof(unsigned char);
                 break;
             default:
                 TIFFErrorExtR(tif, module, "Unsupported bits/sample: %" PRIu16,
-- 
2.54.0

