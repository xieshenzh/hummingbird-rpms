+				if !entry.completed {
+					entry.task.Status = mcp.TaskStatusCancelled
+					entry.task.StatusMessage = err.Error()
+					entry.task.LastUpdatedAt = cancelledAt.UTC().Format(time.RFC3339)
+					entry.completed = true
+					close(entry.done)
+
+					// Decrement active tasks counter
