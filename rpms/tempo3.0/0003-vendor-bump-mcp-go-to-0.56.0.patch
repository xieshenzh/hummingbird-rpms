+		hasTaskHandler = false
+	} else {
+		// Tool not found in either map
+		return nil, &requestError{
+			id:   id,
+			code: mcp.INVALID_PARAMS,
+			err:  fmt.Errorf("tool '%s' not found", request.Params.Name),
+		}
+	}
