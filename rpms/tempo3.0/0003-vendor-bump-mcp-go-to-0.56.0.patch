-	case "string":
-		t.stringKeywords(tags)
-	case "number":
-		t.numericalKeywords(tags)
-	case "integer":
-		t.numericalKeywords(tags)
-	case "array":
-		t.arrayKeywords(tags)
-	case "boolean":
-		t.booleanKeywords(tags)
-	}
-	extras := strings.Split(f.Tag.Get("jsonschema_extras"), ",")
-	t.extraKeywords(extras)
