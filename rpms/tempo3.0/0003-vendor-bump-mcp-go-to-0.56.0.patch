+	// Create task entry (pollInterval is nil - server doesn't set a default)
+	entry, err := s.createTask(ctx, taskID, request.Params.Name, ttl, nil)
+	if err != nil {
+		return nil, &requestError{
+			id:   id,
+			code: mcp.INTERNAL_ERROR,
+			err:  err,
+		}
+	}
