+		for {
+			if err := ctx.Err(); err != nil {
+				yield(mcp.Resource{}, err)
+				return
+			}
+			result, err := c.ListResourcesByPage(ctx, request)
+			if err != nil {
+				yield(mcp.Resource{}, err)
+				return
+			}
+			for _, resource := range result.Resources {
+				if !yield(resource, nil) {
+					return
+				}
+			}
+			if result.NextCursor == "" {
