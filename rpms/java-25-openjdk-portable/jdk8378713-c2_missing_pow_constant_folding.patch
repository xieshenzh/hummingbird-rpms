 Node* CallLeafPureNode::Ideal(PhaseGVN* phase, bool can_reshape) {
   if (is_dead()) {
     return nullptr;
@@ -2424,3 +2444,158 @@ bool CallNode::may_modify_arraycopy_helper(const TypeOopPtr* dest_t, const TypeO
 
