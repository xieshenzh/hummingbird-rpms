---
 tclpkg/gv/Makefile.am | 1 +
 tclpkg/gv/Makefile.in | 1 +
 2 files changed, 2 insertions(+)

diff --git a/tclpkg/gv/Makefile.am b/tclpkg/gv/Makefile.am
index e9cdabf..4373b1c 100644
--- a/tclpkg/gv/Makefile.am
+++ b/tclpkg/gv/Makefile.am
@@ -146,6 +146,7 @@ libgv_R_la_CPPFLAGS = $(BASECPPFLAGS) $(R_CFLAGS)
 libgv_R_la_CXXFLAGS = $(AM_CXXFLAGS) -Wno-cast-function-type -Wno-unused-parameter
 gv_R.cpp: gv.i
 	$(SWIG) -c++ -r -o $@ $(srcdir)/gv.i
+	sed -i 's/SET_S4_OBJECT\((.*)\);/Rf_asS4\(\1, TRUE, 1\);/g' $@
 
 pkgrubydir = $(pkglibdir)/ruby
 RUBY_data =
diff --git a/tclpkg/gv/Makefile.in b/tclpkg/gv/Makefile.in
index a58ce8f..fab1afa 100644
--- a/tclpkg/gv/Makefile.in
+++ b/tclpkg/gv/Makefile.in
@@ -2898,6 +2898,7 @@ gv_python3.cpp: gv.i
 	$(SWIG) -c++ -python -o $@ $(srcdir)/gv.i
 gv_R.cpp: gv.i
 	$(SWIG) -c++ -r -o $@ $(srcdir)/gv.i
+	sed -i 's/SET_S4_OBJECT\((.*)\);/Rf_asS4\(\1, TRUE, 1\);/g' $@
 gv_ruby.cpp: gv.i
 	$(SWIG) -c++ -ruby -o $@ $(srcdir)/gv.i
 gv_tcl.cpp: gv.i
