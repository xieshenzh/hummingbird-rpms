 int
 mm_answer_authpassword(struct ssh *ssh, int sock, struct sshbuf *m)
 {
@@ -1392,7 +1421,7 @@ monitor_valid_userblob(struct ssh *ssh, const u_char *data, u_int datalen)
 	struct sshbuf *b;
 	struct sshkey *hostkey = NULL;
 	const u_char *p;
-	char *userstyle, *cp;
+	char *userstyle, *s, *cp;
