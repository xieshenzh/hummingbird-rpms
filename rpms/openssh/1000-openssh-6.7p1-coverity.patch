 				error("%.200s line %d: glob failed for %s.",
 				    filename, linenum, arg2);
+				free(arg2);
 				goto out;
 			}
 			free(arg2);
diff --git a/servconf.c b/servconf.c
index e05a31584..3ffa49c3a 100644
--- a/servconf.c
