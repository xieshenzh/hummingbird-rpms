-        if a.iter().any(|x| x.is_nan()) {
-            return TestResult::discard();
-        }
-
-        let actual = a.iter().cloned().tree_reduce(f64::atan2);
-
-        while a.len() > 1 {
-            a = collapse_adjacent(a, f64::atan2);
-        }
-        let expected = a.pop();
-
-        TestResult::from_bool(actual == expected)
-    }
