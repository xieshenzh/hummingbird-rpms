diff -ruN patch-old/vendor/itertools/.github/workflows/ci.yml patch-new/vendor/itertools/.github/workflows/ci.yml
--- patch-old/vendor/itertools/.github/workflows/ci.yml	2006-07-23 20:21:28.000000000 -0500
+++ patch-new/vendor/itertools/.github/workflows/ci.yml	1969-12-31 18:00:00.000000000 -0600
