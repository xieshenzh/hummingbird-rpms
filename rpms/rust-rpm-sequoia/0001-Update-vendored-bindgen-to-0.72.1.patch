-    /// but much more efficient.
-    ///
-    /// ```
-    /// use itertools::Itertools;
-    ///
-    /// // A random permutation of 0..15
-    /// let numbers = vec![6, 9, 1, 14, 0, 4, 8, 7, 11, 2, 10, 3, 13, 12, 5];
-    ///
-    /// let five_smallest = numbers
-    ///     .into_iter()
-    ///     .k_smallest(5);
-    ///
-    /// itertools::assert_equal(five_smallest, 0..5);
-    /// ```
