-    fn partition_map<A, B, F, L, R>(self, mut predicate: F) -> (A, B)
-    where
-        Self: Sized,
-        F: FnMut(Self::Item) -> Either<L, R>,
-        A: Default + Extend<L>,
-        B: Default + Extend<R>,
