-        /// Otherwise the item is consumed and None is returned
-        #[inline(always)]
-        fn filter<I>(&mut self, item: I) -> Option<I>
-        where
-            F: KeyMethod<Key, I>,
-        {
-            let kv = self.key_method.make(item);
-            match self.used.get_mut(kv.key_ref()) {
-                None => {
-                    self.used.insert(kv.key(), false);
-                    self.pending += 1;
-                    None
-                }
-                Some(true) => None,
-                Some(produced) => {
-                    *produced = true;
-                    self.pending -= 1;
-                    Some(kv.value())
-                }
-            }
-        }
-    }
