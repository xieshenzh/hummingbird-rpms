summary: centos stream tests for mariadb10.11

environment:
  BUILD_PACKAGE: mariadb10.11-server

prepare:
  how: shell
  script: |
    dnf install -y $BUILD_PACKAGE

discover:
  how: fmf
  url: https://gitlab.com/redhat/centos-stream/tests/mariadb/
  ref: main
  filter: tag:base-package

adjust:
  context:
    dbver: mariadb-10.11

execute:
  how: tmt
