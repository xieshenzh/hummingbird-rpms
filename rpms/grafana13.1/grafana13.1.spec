%description
Grafana is an open-source observability platform for visualizing metrics,
logs, and traces from many different data sources.

%prep
%goprep -p1
tar -xf %{S:1}
tar -xf %{S:3}

%generate_buildrequires
%go_vendor_license_buildrequires -c %{S:2}

%build
%global gomodulesmode GO111MODULE=on
export GOFLAGS="-mod=vendor -buildvcs=false"

# The source tree carries Yarn 4 itself. Keep the install hermetic and use the
# package-local mirror rather than Yarn's user-global cache.
export YARN_ENABLE_GLOBAL_CACHE=false
export YARN_CACHE_FOLDER=.yarn/cache
export YARN_ENABLE_NETWORK=false
node .yarn/releases/yarn-4.15.0.cjs install --immutable --immutable-cache

# Nx's daemon is unnecessary for a one-shot package build.
export NX_DAEMON=false
export NODE_OPTIONS=--max-old-space-size=8192
node .yarn/releases/yarn-4.15.0.cjs build

# Grafana 13 produces one binary with server and cli subcommands.
export GO_LDFLAGS="-X main.version=%{version} \
                   -X main.commit=rpm \
                   -X main.buildBranch=rpm \
                   -X main.buildstamp=${SOURCE_DATE_EPOCH}"
%gobuild -o %{gobuilddir}/bin/grafana %{goipath}/pkg/cmd/grafana

%install
%go_vendor_license_install -M -c %{S:2}

install -D -p -m 0755 %{gobuilddir}/bin/grafana \
    %{buildroot}%{_datadir}/grafana/bin/grafana
install -D -p -m 0755 packaging/wrappers/grafana \
    %{buildroot}%{_bindir}/grafana
install -D -p -m 0755 packaging/wrappers/grafana-server \
    %{buildroot}%{_bindir}/grafana-server
install -D -p -m 0755 packaging/wrappers/grafana-cli \
    %{buildroot}%{_bindir}/grafana-cli

cp -a public %{buildroot}%{_datadir}/grafana/
cp -a conf %{buildroot}%{_datadir}/grafana/
install -D -p -m 0644 conf/sample.ini \
    %{buildroot}%{_sysconfdir}/grafana/grafana.ini

%check
go_vendor_license -c %{S:2} \
    -C %{S:0} -C %{S:1} --use-archive \
    report expression --verify '%{license}'
%if %{with check}
export GOFLAGS="-mod=vendor -buildvcs=false"
# Zanzana's SQLite tests use a fixed database name beneath os.TempDir.
export TMPDIR="${PWD}/test-tmp"
mkdir -p "${TMPDIR}"
%gotest -short -timeout=30m ./...
%endif

%files -f %{go_vendor_license_filelist}
%doc CHANGELOG.md NOTICE.md README.md
%config(noreplace) %{_sysconfdir}/grafana/grafana.ini
%{_bindir}/grafana
%{_bindir}/grafana-cli
%{_bindir}/grafana-server
%{_datadir}/grafana/

%changelog
%autochangelog
