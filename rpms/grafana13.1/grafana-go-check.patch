From: Hummingbird <hummingbird@redhat.com>
Subject: [PATCH] Fix pre-existing %check failures in grafana 13.1.3

xorm.go is tagged //go:build go1.8. Go 1.21+ treats that as the file's
language version (clamped to go1.21), so math/rand/v2.Int64N (a Go 1.22
API) fails to compile during `go test`. Raise the build tag to go1.22.

The postgres vector_collection_upsert snapshot still expects a raw
byte-array dump of JSON metadata; the 13.1.3 code emits the JSON string.

diff --git a/pkg/storage/unified/search/vector/testdata/postgres--vector_collection_upsert-simple.sql b/pkg/storage/unified/search/vector/testdata/postgres--vector_collection_upsert-simple.sql
index 4b98ba895a94..2881c9ea0c95 100755
--- a/pkg/storage/unified/search/vector/testdata/postgres--vector_collection_upsert-simple.sql
+++ b/pkg/storage/unified/search/vector/testdata/postgres--vector_collection_upsert-simple.sql
@@ -19,7 +19,7 @@ VALUES (
     'panel/5',
     'folder-uid',
     'panel title with queries',
-    '[123 34 100 97 116 97 115 111 117 114 99 101 95 117 105 100 115 34 58 91 34 100 115 49 34 93 125]',
+    '{"datasource_uids":["ds1"]}',
     '[0.1,0.2,0.3]'
 )
 ON CONFLICT ("resource", "namespace", "model", "uid", "subresource")
@@ -27,7 +27,7 @@ DO UPDATE SET
     "title"      = 'CPU Dashboard',
     "folder"     = 'folder-uid',
     "content"    = 'panel title with queries',
-    "metadata"   = '[123 34 100 97 116 97 115 111 117 114 99 101 95 117 105 100 115 34 58 91 34 100 115 49 34 93 125]',
+    "metadata"   = '{"datasource_uids":["ds1"]}',
     "embedding"  = '[0.1,0.2,0.3]',
     "updated_at" = CURRENT_TIMESTAMP
 ;
diff --git a/pkg/util/xorm/xorm.go b/pkg/util/xorm/xorm.go
index da15e50762d4..8f5c2944a0a0 100644
--- a/pkg/util/xorm/xorm.go
+++ b/pkg/util/xorm/xorm.go
@@ -2,8 +2,7 @@
 // Use of this source code is governed by a BSD-style
 // license that can be found in the LICENSE file.
 
-//go:build go1.8
-// +build go1.8
+//go:build go1.22
 
 package xorm
 
