Version:                2.12.12

%gometa -L -f


Name:           nats-server2.12
Release:        1.1%{?dist}
Summary:        High-performance server for NATS, the cloud and edge native messaging system

# Generated by go-vendor-tools
License:        Apache-2.0 AND BSD-3-Clause AND MIT
URL:            %{gourl}
Source0:        %{gosource}
