+					 pwd, execcon);
+		if (!tmpdir_r) {
+			fprintf(stderr, _("Failed to create runtime temporary directory\n"));
+			return -1;
+		}
 	}
 
 	/* spawn child process */
@@ -927,11 +939,10 @@ int main(int argc, char **argv) {
 		char *XDG_SESSION_TYPE = NULL;
 		int rc = -1;
 		char *resolved_path = NULL;
-		char *wayland_path_s = NULL; /* /tmp/.../wayland-0 */
