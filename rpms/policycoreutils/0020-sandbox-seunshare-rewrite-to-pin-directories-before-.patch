+			if (sb.st_dev != st_runuserdir_s.st_dev ||
+				sb.st_ino != st_runuserdir_s.st_ino)
+				goto childerr;
+			if (check_owner_uid(uid, runuserdir_s, &sb))
+				goto childerr;
+		}
+
 		resolved_path = realpath(pwd->pw_dir,NULL);
 		if (! resolved_path) goto childerr;
 
