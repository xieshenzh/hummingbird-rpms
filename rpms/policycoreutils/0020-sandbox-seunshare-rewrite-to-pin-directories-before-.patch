-		char *pipewire_path_s = NULL; /* /tmp/.../pipewire-0 */
-		char *pipewire_path = NULL; /* /run/user/UID/pipewire-0 */
-
+		int fd_homedir_s = -1, fd_curhomedir = -1;
+		int fd_runuserdir_s = -1, fd_runtime_dir = -1;
+		int fd_tmpdir_r = -1, fd_tmp = -1, fd_var_tmp = -1;
