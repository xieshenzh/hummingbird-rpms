-			struct stat sb;
-
-			if (verify_directory(RUNTIME_DIR, NULL, &sb) < 0 ||
-				check_owner_uid(uid, RUNTIME_DIR, &sb) < 0)
+			fd_runtime_dir = pin_dir(RUNTIME_DIR, &sb);
+			if (fd_runtime_dir < 0)
