new file mode 100644
index 0000000..79c3c2c
--- /dev/null
+++ b/crates/openshell-supervisor-network/tests/procfs_socket_ownership.rs
@@ -0,0 +1,86 @@
+// SPDX-FileCopyrightText: Copyright (c) 2025-2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Process-isolated tests for socket ownership across `fork()`.
+//!
+//! These tests must not share a test executable with other socket identity
+//! tests: a forked child inherits every descriptor held by the process, which
+//! can make concurrent tests observe owners that do not belong to their setup.
+
+#![cfg(target_os = "linux")]
+
+use openshell_supervisor_network::procfs::{
+    WorkloadProxyTcpConnection, resolve_tcp_peer_socket_owners,
+};
+use std::collections::HashSet;
+use std::net::{TcpListener, TcpStream};
+use std::time::{Duration, Instant};
+
+struct ChildGuard(libc::pid_t);
+
+impl Drop for ChildGuard {
+    fn drop(&mut self) {
+        #[allow(unsafe_code)]
+        unsafe {
+            libc::kill(self.0, libc::SIGKILL);
+            libc::waitpid(self.0, std::ptr::null_mut(), 0);
+        }
+    }
+}
+
+#[test]
+fn resolve_tcp_peer_socket_owners_returns_all_forked_socket_holders() {
+    let listener = TcpListener::bind("127.0.0.1:0").expect("bind listener");
+    let proxy_addr = listener.local_addr().expect("listener address");
+    let stream = TcpStream::connect(proxy_addr).expect("connect");
+    let workload_addr = stream.local_addr().expect("stream address");
+    let connection = WorkloadProxyTcpConnection::new(workload_addr, proxy_addr);
+    let (_accepted, _) = listener.accept().expect("accept");
+
+    #[allow(
+        unsafe_code,
+        reason = "the test verifies socket inheritance across fork"
+    )]
+    let child_pid = unsafe { libc::fork() };
+    assert!(child_pid >= 0, "fork failed");
+    if child_pid == 0 {
+        #[allow(
+            unsafe_code,
+            reason = "the forked child may only call async-signal-safe functions"
+        )]
+        unsafe {
+            libc::sleep(30);
+            libc::_exit(0);
+        }
+    }
+
+    let _guard = ChildGuard(child_pid);
+    let child_pid_u32 = child_pid.cast_unsigned();
+    let entrypoint_pid = std::process::id();
+    let deadline = Instant::now() + Duration::from_secs(5);
+    let owners = loop {
+        let owners = resolve_tcp_peer_socket_owners(entrypoint_pid, connection)
+            .expect("resolve socket owners");
+        let owner_pids = owners
+            .owners
+            .iter()
+            .map(|owner| owner.pid)
+            .collect::<HashSet<_>>();
+        if owner_pids.contains(&entrypoint_pid) && owner_pids.contains(&child_pid_u32) {
+            break owners;
+        }
+        assert!(
+            Instant::now() < deadline,
+            "timed out waiting for forked child to appear as a socket owner; got {owner_pids:?}"
+        );
+        std::thread::sleep(Duration::from_millis(20));
+    };
+
+    let owner_pids = owners
+        .owners
+        .iter()
+        .map(|owner| owner.pid)
+        .collect::<HashSet<_>>();
+    assert!(owner_pids.contains(&entrypoint_pid));
+    assert!(owner_pids.contains(&child_pid_u32));
+}
