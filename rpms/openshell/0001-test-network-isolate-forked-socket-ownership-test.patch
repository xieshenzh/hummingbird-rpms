+        normal = True,
+        normal_dev = True,
+    ) + [":openshell-supervisor-network"],
+)
+
 rust_test(
     name = "system_inference_integration_test",
     srcs = ["tests/system_inference.rs"],
@@ -53,6 +64,7 @@ rustfmt_test(
         ":accept_fd_exhaustion_integration_test",
         ":openshell-supervisor-network",
         ":openshell-supervisor-network_test",
+        ":procfs_socket_ownership_integration_test",
         ":sigv4_localstack_integration_test",
         ":system_inference_integration_test",
         ":websocket_upgrade_integration_test",
