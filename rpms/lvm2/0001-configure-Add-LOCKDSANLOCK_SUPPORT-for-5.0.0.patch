From f32cc94b4fe7da44bfa5acfe3d62b3f3505ecba3 Mon Sep 17 00:00:00 2001
From: Marian Csontos <mcsontos@redhat.com>
Date: Tue, 17 Mar 2026 19:40:27 +0100
Subject: [PATCH 1/4] configure: Add LOCKDSANLOCK_SUPPORT for 5.0.0

(cherry picked from commit 224eb9e3b8415eff9e213f8fddf45b8bcee5ba7e)
---
 configure    | 8 ++++++++
 configure.ac | 1 +
 2 files changed, 9 insertions(+)

diff --git a/configure b/configure
index 12a50268d..4d2f6e740 100755
--- a/configure
+++ b/configure
@@ -12213,6 +12213,14 @@ fi
   test $ac_status = 0; }; then
   LOCKDSANLOCK_SUPPORT=420
 fi
+	if test -n "$PKG_CONFIG" && \
+    { { printf "%s\n" "$as_me:${as_lineno-$LINENO}: \$PKG_CONFIG --exists --print-errors \"libsanlock_client >= 5.0.0\""; } >&5
+  ($PKG_CONFIG --exists --print-errors "libsanlock_client >= 5.0.0") 2>&5
+  ac_status=$?
+  printf "%s\n" "$as_me:${as_lineno-$LINENO}: \$? = $ac_status" >&5
+  test $ac_status = 0; }; then
+  LOCKDSANLOCK_SUPPORT=500
+fi
 
 pkg_failed=no
 { printf "%s\n" "$as_me:${as_lineno-$LINENO}: checking for libsanlock_client >= 3.7.0" >&5
diff --git a/configure.ac b/configure.ac
index b3f5d6e74..e2026e768 100644
--- a/configure.ac
+++ b/configure.ac
@@ -939,6 +939,7 @@ AS_IF([test "$BUILD_LOCKDSANLOCK" = "yes"], [
 	PKG_CHECK_EXISTS(libsanlock_client >= 4.0.0, [LOCKDSANLOCK_SUPPORT=400])
 	PKG_CHECK_EXISTS(libsanlock_client >= 4.1.0, [LOCKDSANLOCK_SUPPORT=410])
 	PKG_CHECK_EXISTS(libsanlock_client >= 4.2.0, [LOCKDSANLOCK_SUPPORT=420])
+	PKG_CHECK_EXISTS(libsanlock_client >= 5.0.0, [LOCKDSANLOCK_SUPPORT=500])
 	PKG_CHECK_MODULES(LIBSANLOCKCLIENT, libsanlock_client >= 3.7.0, [BUILD_LVMLOCKD="yes"])
 	AC_DEFINE_UNQUOTED([LOCKDSANLOCK_SUPPORT], [$LOCKDSANLOCK_SUPPORT], [Define version of sanlock.])
 ])
-- 
2.53.0

