summary: dbus-python gating tests

prepare:
    how: install
    package:
      - python3-dbus
      - gcc
      - make
      - automake
      - autoconf
      - autoconf-archive
      - libtool

discover:
    how: shell
    dist-git-source: true
    dist-git-install-builddeps: true
    tests:
      - name: upstream test suite
        test: |
          set -x
          if [ -z "$PKG_VER" ]; then
              PKG_VER=`rpmspec -q --srpm --qf "%{version}" dbus-python.spec`
          fi
          if [ -z "$PKG_VER" ]; then
              echo "Error: Unable to extract package version"
              exit 1
          fi
          pushd $TMT_SOURCE_DIR/dbus-python-${PKG_VER}

          ./autogen.sh && ./configure && make check

execute:
  - how: tmt
