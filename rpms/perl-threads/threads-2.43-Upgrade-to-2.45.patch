From ede5b28e52781606dc82e6a2eb16601ad46d78e0 Mon Sep 17 00:00:00 2001
From: Jitka Plesnikova <jplesnik@redhat.com>
Date: Thu, 4 Jun 2026 14:53:46 +0200
Subject: [PATCH] Upgrade to 2.45

---
 lib/threads.pm |   4 +-
 threads.xs     | 148 +++++++++++++++++++++++++------------------------
 2 files changed, 79 insertions(+), 73 deletions(-)

diff --git a/lib/threads.pm b/lib/threads.pm
index 85c48b9..93db76d 100644
--- a/lib/threads.pm
+++ b/lib/threads.pm
@@ -5,7 +5,7 @@ use 5.008;
 use strict;
 use warnings;
 
-our $VERSION = '2.43';      # remember to update version in POD!
+our $VERSION = '2.45';      # remember to update version in POD!
 my $XS_VERSION = $VERSION;
 #$VERSION = eval $VERSION;
 
@@ -134,7 +134,7 @@ threads - Perl interpreter-based threads
 
 =head1 VERSION
 
-This document describes threads version 2.43
+This document describes threads version 2.45
 
 =head1 WARNING
 
diff --git a/threads.xs b/threads.xs
index 84ad487..d54ab0b 100644
--- a/threads.xs
+++ b/threads.xs
@@ -147,7 +147,7 @@ typedef struct {
 
