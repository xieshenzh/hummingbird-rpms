+static int
 S_block_most_signals(sigset_t *oldmask)
 {
     sigset_t newmask;
@@ -173,7 +173,7 @@ S_block_most_signals(sigset_t *oldmask)
 }
 
 /* Set the signal mask for this thread to newmask */
-STATIC int
+static int
 S_set_sigmask(sigset_t *newmask)
 {
 #if defined(VMS)
