{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "ignorePaths": [
    "rpms/**",
    ".tekton/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update pinned image digests in generate_resources.py",
      "managerFilePatterns": ["/ci/generate_resources\\.py$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\n\\s*[A-Z_]+\\s*=\\s*\"[^\"@:]+(?::(?<currentValue>[^\"@]+))?@(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "currentValueTemplate": "latest",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update release-service-catalog git reference in Konflux template",
      "managerFilePatterns": ["/konflux-templates/konflux-resources\\.yml\\.j2$/"],
      "matchStrings": [
        "{#-?\\s*renovate:\\s*datasource=git-refs\\s+depName=(?<depName>\\S+)\\s+branch=(?<currentValue>\\S+)\\s*#}\\n{%-?\\s*set\\s+release_catalog_revision\\s*=\\s*\"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    },
    {
      "customType": "regex",
      "description": "Update release-service-catalog git reference in rendered Konflux YAML",
      "managerFilePatterns": ["/konflux-templates/rendered\\.yml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=git-refs\\s+depName=(?<depName>\\S+)\\s+branch=(?<currentValue>\\S+)\\n\\s*value:\\s*(?<currentDigest>[a-f0-9]{40})"
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    }
  ],
  "packageRules": [
    {
      "description": "Group all rpmbuild-pipeline updates together",
      "matchPackageNames": ["/rpmbuild-pipeline/"],
      "groupName": "rpmbuild-pipeline"
    },
    {
      "description": "Group all syft image updates together",
      "matchPackageNames": ["/hummingbird-community\\/syft/"],
      "groupName": "syft-image"
    },
    {
      "description": "Regenerate rendered Tekton YAML after image digest updates",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["ci/generate_resources.py"],
      "postUpgradeTasks": {
        "commands": ["ci/renovate.sh"],
        "fileFilters": [".tekton/**"],
        "executionMode": "branch"
      }
    }
  ]
}
