{%- macro release_plan_admission(name, application_prefix, component_list, release_org, single_component_mode, service_account_name) -%}---
apiVersion: appstudio.redhat.com/v1alpha1
kind: ReleasePlanAdmission
metadata:
  labels:
    release.appstudio.openshift.io/block-releases: 'false'
    pp.engineering.redhat.com/business-unit: rhel-platforms
  name: {{ name }}
  namespace: {{ release_tenant }}
spec:
  applications:
    - {{ application_prefix }}-{{ branch }}
  data:
    intention: production
    pulp:
      domain: {{ pulp_unsigned_domain }}
      secretName: {{ pulp_secret_name }}
    signOptions:
      signKeytab:
        principal: "konflux-release-signing-prod@IPA.REDHAT.COM"
        name: "keytab"
        secret: "konflux-release-signing-prod-sa"
      signPipelineImage: "quay.io/konflux-ci/signing:latest"
      signPipelineServiceAccount: "signing-pipeline-sa"
      skipUploadToPulp: true
      artifactStorageSecret: "signing-artifact-storage-prod"
      signKeyAlias:
        key: "release4,release2,ima"
      unsignedRpmsDomain: {{ pulp_unsigned_domain }}
      signedRpmsDomain: {{ pulp_signed_domain }}
    releaseNotes:
      product_id: [1071]
      product_name: "Red Hat Hardened Images"
      product_version: "1"
      # note: these fields are generated by the
      #       convertyaml collector
      # solution:
      # synopsis:
      # topic:
      # description:
      #
    singleComponentMode: {{ single_component_mode | tojson }}
    sign:
      configMapName: hacbs-signing-pipeline-config-staging-e2e
      cosignSecretName: konflux-cosign-signing-stage
    pyxis:
      secret: pyxis-staging-secret
      server: stage
    atlas:
      server: stage
    mapping:
      rpm-repositories:
        - name: x86_64
          arch: x86_64
          repository_id: public-hummingbird-x86_64-rpms
          repository_name: x86_64
          distro: hummingbird-20251124
        - name: aarch64
          arch: aarch64
          repository_id: public-hummingbird-aarch64-rpms
          repository_name: aarch64
          distro: hummingbird-20251124
        - name: src
          arch: src
          repository_id: public-hummingbird-source-rpms
          repository_name: source
          distro: hummingbird-20251124
        # leaving this here for backwards compatibility before HUM-808
        - name: source
          arch: source
          repository_id: public-hummingbird-source-rpms
          repository_name: source
          distro: hummingbird-20251124
      defaults:
        pushSourceContainer: true
      components:
{%- for component in component_list %}
        - name: {{ component.component_name }}
          contentType: rpm
{%- endfor %}
  origin: {{ tenant }}
  pipeline:
    pipelineRef:
      params:
        - name: url
          value: {{ pipeline_url }}
        - name: revision
          value: {{ pipeline_revision }}
        - name: pathInRepo
          value: "pipelines/managed/push-rpms-to-pulp/push-rpms-to-pulp.yaml"
      resolver: git
    taskRunSpecs:
      - pipelineTaskName: populate-release-notes
        stepSpecs:
          - computeResources:
              limits:
                cpu: '1'
                memory: 256Mi
              requests:
                cpu: '1'
                memory: 256Mi
            name: populate-release-notes-artifacts
      - pipelineTaskName: upload-src-rpm-sbom-attestation
        stepSpecs:
          - computeResources:
              limits:
                memory: 1Gi
              requests:
                cpu: '1'
                memory: 1Gi
            name: upload
    serviceAccountName: {{ service_account_name }}
    timeouts:
      pipeline: 4h0m0s
      tasks: 4h0m0s
  policy: rpm-hummingbird-stage
{%- endmacro -%}
